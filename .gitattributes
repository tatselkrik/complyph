* text=auto eol=lf
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.exe binary
*.zip binary
library/starter/raw/** binary
library/starter/text/** -whitespace

# Preserved reference publications are data for the offline legal library.
library/starter/** linguist-vendored=true

# Third-party dependency sources are maintained separately from the app.
vendor/** linguist-vendored=true
